# ─────────────────────────────────────────────────────────────
# TRACEY 환경변수 (모두 서버 전용 — 브라우저 번들에 포함되지 않음)
# 복사: cp .env.example .env.local
# 운영(NODE_ENV=production)에서 [필수] 값이 없으면 API 가 503 으로 '안전하게 실패'합니다.
# ─────────────────────────────────────────────────────────────

# [필수·운영] 세션 쿠키 서명 비밀값(32자 이상 무작위). 예: openssl rand -hex 32
TRACEY_SESSION_SECRET=
# [필수·운영] 서버가 만든 논문 청크·문헌 목록 서명용(위조 인용 차단). 예: openssl rand -hex 32
TRACEY_SIGNING_SECRET=

# ── 인증·저장소 ──
# local(기본): 서버 파일에 계정·상태 저장(단일 서버·시연용) / supabase: Supabase Auth + Postgres(RLS)
TRACEY_AUTH_MODE=local
# 파일 저장 위치(기본: ./.data/app, ./.data/corpora). 서버리스에서는 영구 디스크가 없으므로 supabase 모드 권장
TRACEY_APP_DATA_DIR=
TRACEY_DATA_DIR=
TRACEY_CACHE_DIR=
# supabase 모드에서 필요(Settings → API)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# 백그라운드 코퍼스 구축이 corpora 테이블에 쓸 때만 사용. 절대 클라이언트에 노출 금지
SUPABASE_SERVICE_ROLE_KEY=

# ── Claude (선택: 없으면 규칙 기반 모드) ──
ANTHROPIC_API_KEY=
# 모델은 코드에 하드코딩하지 않습니다. 비워 두면 아래 기본값을 사용(배포 시 명시 권장)
ANTHROPIC_MODEL=claude-sonnet-5-5
# 검색 계획·연결 확인 등 가벼운 작업용(선택)
ANTHROPIC_MODEL_FAST=claude-haiku-5-5
ANTHROPIC_TIMEOUT_MS=45000
# 1 이면 키가 있어도 Claude 호출 안 함(비용 통제·비교 실험용)
TRACEY_LLM_DISABLED=

# ── 학술 API ──
# OpenAlex: 키가 없으면 IP 단위 공용 일일 예산(소진 시 HTTP 429). https://openalex.org/settings/api 무료 발급 권장
OPENALEX_API_KEY=
OPENALEX_MAILTO=
# Semantic Scholar(선택): 키 없이는 429 가 잦음 — 실패해도 OpenAlex 결과는 보존
S2_API_KEY=

# ── 작업 큐 ──
# 크론이 /api/jobs/tick 을 호출할 때 Authorization: Bearer <CRON_SECRET>. 없으면 tick 비활성(503)
CRON_SECRET=
# 실행 중 작업 리스(ms). 만료되면 재시작으로 간주하고 재개
TRACEY_JOB_LEASE_MS=90000

# ── 개발·시연 전용 (운영에서 사용 금지) ──
# 1 이면 production 빌드에서도 개발용 기본 비밀값 허용(로컬 시연용). 운영 보안으로 쓰지 마세요
TRACEY_ALLOW_INSECURE_DEV=
# 속도 제한 배수(E2E 테스트 서버에서만 늘림)
TRACEY_RATE_LIMIT_SCALE=
# 프록시 뒤에서 Node fetch 가 HTTPS_PROXY 를 쓰게 할 때(Node 22.21+). 일반 서버는 불필요
NODE_USE_ENV_PROXY=
